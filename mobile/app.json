{
  "expo": {
    "name": "Report Card",
    "slug": "report-card-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reportcard",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reportcard.mobile"
    },
    "android": {
      "package": "com.reportcard.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4f46e5"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share the bus's location with the school while you drive a trip."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of a mark sheet so its marks can be read in.",
          "photosPermission": "Choose a photo of a mark sheet so its marks can be read in.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": false,
      "onDemandFilesystem": false
    },
    "owner": "alexotis-team",
    "extra": {
      "eas": {
        "projectId": "2de9e93f-553d-4b0a-9988-100e744aad0a"
      }
    }
  }
}
