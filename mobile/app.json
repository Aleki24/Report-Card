{
  "expo": {
    "name": "Skulbase",
    "slug": "report-card-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "skulbase",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skulbase.app"
    },
    "android": {
      "package": "com.skulbase.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "skulbase.com",
              "pathPrefix": "/verify"
            },
            {
              "scheme": "https",
              "host": "skulbase.com",
              "pathPrefix": "/activate"
            },
            {
              "scheme": "https",
              "host": "www.skulbase.com",
              "pathPrefix": "/verify"
            },
            {
              "scheme": "https",
              "host": "www.skulbase.com",
              "pathPrefix": "/activate"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share the bus's location with the school while you drive a trip."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of homework to hand in, or of a mark sheet so its marks can be read in.",
          "photosPermission": "Choose a photo of a mark sheet so its marks can be read in.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "./plugins/withCrashReporter",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": false,
      "onDemandFilesystem": false
    },
    "owner": "alexotis-team",
    "extra": {
      "eas": {
        "projectId": "2de9e93f-553d-4b0a-9988-100e744aad0a"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2de9e93f-553d-4b0a-9988-100e744aad0a"
    }
  }
}
